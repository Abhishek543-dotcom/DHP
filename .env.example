# ============================================
# Lakehouse Platform - Environment Variables
# ============================================
# Copy this file to .env and modify as needed

# Database
DATABASE_URL=postgresql+asyncpg://lakehouse:dev-db-password-change-me@localhost:5432/lakehouse
AUTO_CREATE_TABLES=true

# Kafka
KAFKA_BROKERS=localhost:29092

# Redis
REDIS_URL=redis://localhost:6379

# API authentication
API_KEY=dev-api-key-change-me
INTERNAL_API_TOKEN=dev-internal-token-change-me

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dev-access-key-change-me
S3_SECRET_KEY=dev-secret-key-change-me
S3_REGION=us-east-1
S3_WAREHOUSE_BUCKET=lakehouse-warehouse

# Loki
LOKI_URL=http://localhost:3100

# Service URLs (for local dev, services run on different ports)
LOG_SERVICE_URL=http://localhost:8003
LOG_SERVICE_API_KEY=dev-api-key-change-me
JOB_SERVICE_URL=http://localhost:8001

# Orchestrator
K8S_IN_CLUSTER=false
K8S_NAMESPACE=lakehouse-jobs
SPARK_IMAGE=lakehouse-spark:3.5.0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001,http://localhost:8002,http://localhost:8003,http://localhost:8004

# Debug
DEBUG=true

